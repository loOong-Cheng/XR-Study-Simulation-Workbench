{
  "schemaVersion": "1.0",
  "id": "synthetic-haptic-buttons",
  "title": "Haptic feedback for mid-air buttons in VR",
  "researchQuestion": "How do three kinds of feedback for pressing mid-air buttons in VR (visual feedback only, a vibrotactile buzz, a patterned vibrotactile pulse) differ in entry time, errors, how far the finger overshoots the button, confidence, workload, presence and preference?",
  "agentQuestions": "Which agent configurations reproduce the human differences between the three designs? At individual level: does the person's background, their hand movement during practice, or their measured task performance (given as inputs) improve the forecasts for that person? All participants and data in this example are invented.",
  "synthetic": true,
  "design": "within-subjects",
  "predictionLevel": "population",
  "predictionTiming": "after-experience",
  "conditions": [
    {
      "id": "visual",
      "label": "Visual feedback only"
    },
    {
      "id": "buzz",
      "label": "Vibrotactile buzz"
    },
    {
      "id": "pulse",
      "label": "Patterned pulse"
    }
  ],
