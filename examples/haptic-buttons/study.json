  "runtime": {
    "engine": "custom",
    "backend": "custom",
    "observation": "mono",
    "deviceProfile": "Standalone VR headset with optical hand tracking and a vibrotactile actuator on the right index fingertip (participants); no app for agents",
    "requiredCapabilities": []
  },
  "outcomes": [
    {
      "id": "completion-time",
      "label": "Completion time per sequence",
      "domain": "objective",
      "unit": "seconds per sequence",
      "scale": "continuous",
      "range": [
        1,
        60
      ],
      "aggregation": "geometric",
      "family": "task-time",
      "weight": 1,
      "phaseIds": [
        "main"
      ],
      "description": "Seconds from a sequence appearing to its last correct digit, geometric mean over the ten scored sequences of a design (practice excluded). Corrections count as part of the time."
    },
    {
      "id": "error-rate",
      "label": "Error rate",
      "domain": "objective",
      "unit": "proportion of digit presses",
      "scale": "proportion",
      "range": [
        0,
        1
      ],
      "aggregation": "arithmetic",
      "family": "task-errors",
      "weight": 1,
      "phaseIds": [
        "main"
      ],
      "description": "Wrong digit presses (a wrong key, or an unintended second activation of the same key) / all digit presses in the ten scored sequences. Presses of the delete key are not counted."
    },
    {
      "id": "overshoot",
      "label": "Overshoot depth",
      "domain": "objective",
      "unit": "mm past the activation plane",
      "scale": "continuous",
      "range": [
        0,
        40
      ],
      "aggregation": "arithmetic",
      "family": "press-depth",
      "weight": 1,
      "phaseIds": [
        "main"
      ],
      "description": "How far the index fingertip travelled past a key's activation plane before turning back, mean over all digit presses in the ten scored sequences."
    },
    {
      "id": "confidence",
      "label": "Press confidence",
      "domain": "subjective",
      "unit": "1–7",
      "scale": "ordinal",
      "range": [
        1,
        7
      ],
      "aggregation": "arithmetic",
      "family": "confidence",
      "weight": 1,
      "phaseIds": [
        "main",
        "questionnaire"
      ],
      "description": "Single item after each design: \"I was confident that each press registered\" (1 = not at all, 7 = completely)."
    },
    {
      "id": "workload",
      "label": "Workload (raw NASA-TLX)",
      "domain": "subjective",
      "unit": "0–100 item mean",
      "scale": "continuous",
      "range": [
        0,
        100
      ],
      "aggregation": "arithmetic",
      "family": "workload",
      "weight": 1,
      "phaseIds": [
        "main",
        "questionnaire"
      ],
      "components": [
        "mental",
        "physical",
        "temporal",
        "performance",
        "effort",
        "frustration"
      ],
      "componentRule": "mean",
      "description": "Raw (unweighted) NASA-TLX after each design: the mean of six items, each 0–100 in steps of 5 (higher = more demanding). Performance is scored 0 = perfect, 100 = failure, so every item points the same way."
    },
    {
      "id": "presence",
      "label": "Presence (the buttons felt real)",
      "domain": "subjective",
      "unit": "1–7",
      "scale": "ordinal",
      "range": [
        1,
        7
      ],
      "aggregation": "arithmetic",
      "family": "presence",
      "weight": 1,
      "phaseIds": [
        "main",
        "questionnaire"
      ],
      "description": "Single item after each design: \"I felt the buttons were really there\" (1 = not at all, 7 = completely)."
    },
    {
      "id": "preference",
      "label": "Overall preference",
      "domain": "subjective",
      "unit": "rank, 1 = best",
      "scale": "rank",
      "aggregation": "arithmetic",
      "family": "preference",
      "weight": 1,
      "phaseIds": [
        "main",
        "ranking"
      ],
      "description": "At the end of the session, the three designs ranked overall (1 = best, no ties)."
    }
  ],
