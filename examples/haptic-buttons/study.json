      "id": "trajectory",
      "label": "Practice hand movement",
      "kind": "trajectory",
      "description": "data/raw/movement_practice.csv: the person's index-fingertip movement in each practice sequence of each design (path length, mean speed, overshoot past the activation plane). Practice phase only, so it cannot stand in for the scored measures; individual configurations only.",
      "fields": [
        "design",
        "phase",
        "trial",
        "path_length_cm",
        "mean_speed_cm_s",
        "overshoot_mm"
      ],
      "phases": [
