      "id": "evidence",
      "label": "Background note on haptic feedback",
      "kind": "evidence",
      "description": "evidence/haptics-evidence.md: a short, neutral note on haptic feedback for mid-air buttons, written without the synthetic data. No results of this study."
    },
    {
      "id": "demographics",
      "label": "Participant background",
      "kind": "demographics",
      "description": "data/raw/demographics.csv: invented background per participant (age, handedness, hand length, fingertip two-point discrimination threshold, gaming hours, VR experience). The person's own entry for individual configurations, a cohort summary for population ones; never results.",
      "fields": [
        "age",
        "handedness",
        "hand_length_cm",
        "tactile_sensitivity_2pd_mm",
        "gaming_hours_per_week",
        "vr_experience"
      ]
    },
