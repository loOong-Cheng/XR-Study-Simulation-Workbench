  "outcomes": [
    {
      "id": "wpm",
      "label": "Entry speed",
      "domain": "objective",
      "unit": "words per minute",
      "scale": "continuous",
      "range": [
        0,
        60
      ],
      "aggregation": "arithmetic",
      "family": "entry-speed",
      "weight": 1,
      "phaseIds": [
        "main"
      ],
      "description": "(|T| - 1) / S x 60 / 5 per phrase, with T the transcribed phrase and S the seconds from the first key (or gesture) to Enter; a word is five characters. Mean over the ten scored phrases per participant and keyboard."
    },
    {
      "id": "error-rate",
      "label": "Uncorrected error rate",
      "domain": "objective",
      "unit": "proportion of characters (0-1)",
      "scale": "proportion",
      "range": [
        0,
        1
      ],
      "aggregation": "arithmetic",
      "family": "accuracy",
      "weight": 1,
      "phaseIds": [
        "main"
      ],
      "description": "Errors left in the submitted phrase: the minimum string distance between presented and transcribed phrase divided by the longer of the two. Errors corrected before Enter do not count. Mean over the ten scored phrases."
    },
    {
      "id": "entry-time",
      "label": "Entry time per phrase",
      "domain": "objective",
      "unit": "seconds per phrase",
      "scale": "continuous",
      "range": [
        1,
        180
      ],
      "aggregation": "geometric",
      "family": "entry-speed",
      "weight": 1,
      "phaseIds": [
        "main"
      ],
      "description": "Seconds from the first key (or gesture) to Enter; a phrase not finished after 180 s is ended. Geometric mean over the ten scored phrases, because times are right-skewed. In one family with entry speed, so the two share one weight."
    },
    {
      "id": "tlx",
      "label": "Workload (raw NASA-TLX)",
      "domain": "subjective",
      "unit": "0-100 item mean",
      "scale": "continuous",
      "range": [
        0,
        100
      ],
      "aggregation": "arithmetic",
      "family": "workload",
      "weight": 1,
      "phaseIds": [
        "practice",
        "main"
      ],
      "components": [
        "mental",
        "physical",
        "temporal",
        "performance",
        "effort",
        "frustration"
      ],
      "componentRule": "mean",
      "description": "Raw (unweighted) NASA-TLX after each keyboard: six items on 0-100 scales in steps of 5; the score is their mean. Lower means less workload; for performance, 0 = perfect and 100 = failure."
    },
    {
      "id": "arm-comfort",
      "label": "Arm and shoulder comfort",
      "domain": "subjective",
      "unit": "1-7 agreement",
      "scale": "ordinal",
      "range": [
        1,
        7
      ],
      "aggregation": "arithmetic",
      "family": "comfort",
      "weight": 1,
      "phaseIds": [
        "practice",
        "main"
      ],
      "description": "Single item after each keyboard: 'My arms and shoulders felt comfortable while typing with this keyboard' (1 = strongly disagree, 7 = strongly agree)."
    },
    {
      "id": "preference",
      "label": "Preference rank",
      "domain": "subjective",
      "unit": "rank; 1 = first",
      "scale": "rank",
      "aggregation": "arithmetic",
      "family": "preference",
      "weight": 1,
      "phaseIds": [
        "practice",
        "main"
      ],
      "description": "After all four keyboards: 'Which keyboard would you choose to enter text in VR?', ranked from 1 (first choice) to 4, without ties."
    }
  ],
  "analysis": {
    "mode": "both",
    "familyWeights": {
      "entry-speed": 1,
      "accuracy": 1,
      "workload": 1,
      "comfort": 1,
      "preference": 1
    },
