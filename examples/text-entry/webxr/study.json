{
  "schemaVersion": "1.0",
  "id": "synthetic-text-entry-webxr",
  "title": "Mid-air text entry with four virtual keyboards in VR (WebXR app)",
  "researchQuestion": "How do four virtual keyboards for mid-air text entry in VR (a raycast QWERTY keyboard, a drum-like keyboard, a swipe gesture keyboard and a split keyboard) differ in entry speed, uncorrected errors, entry time per phrase, perceived workload, arm and shoulder comfort and preference?",
  "agentQuestions": "The forecasts are made before the study, from what is known in advance; no measured outcome is ever an input. Which configurations reproduce the human differences between the keyboards: the brief alone, the brief with a background note on text entry, or the brief with the cohort's background? Does knowing a person's background help to forecast that person? Does another model, given the same, forecast differently?",
  "synthetic": true,
  "design": "within-subjects",
  "predictionLevel": "population",
  "predictionTiming": "before-experience",
